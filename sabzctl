#!/usr/bin/env bash
# Управление sabz-notifier. Ставится как /usr/local/bin/sabz-notifier
set -euo pipefail

APP="sabz-notifier"
DIR="/opt/${APP}"
SVC_USER="sabz"
UNIT_PATH="/etc/systemd/system/${APP}.service"
CLI_PATH="/usr/local/bin/${APP}"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[36m'; D=$'\e[2m'; N=$'\e[0m'; BD=$'\e[1m'
else R=""; G=""; Y=""; B=""; D=""; N=""; BD=""; fi

ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
die()  { printf '  %s✗%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
need_root() { [ "$(id -u)" = "0" ] || die "нужен root: sudo ${APP} $1"; }

# добивает процессы прошлого входа: свой дисплей :99 и свой порт 6080
stray_kill() {
  pkill -f 'Xvfb :99' 2>/dev/null || true
  pkill -f 'x11vnc -display :99' 2>/dev/null || true
  pkill -f 'websockify.*6080' 2>/dev/null || true
  return 0
}

mode() { grep -E '^BOT_MODE=' "$DIR/.env" 2>/dev/null | cut -d= -f2- || echo light; }
envval() { grep -E "^$1=" "$DIR/.env" 2>/dev/null | cut -d= -f2- || true; }

PY="${DIR}/venv/bin/python3"; [ -x "$PY" ] || PY="/usr/bin/python3"
PW_PATH="$(envval PLAYWRIGHT_BROWSERS_PATH)"
if command -v runuser >/dev/null 2>&1; then AS_USER=(runuser -u "$SVC_USER" --)
else AS_USER=(sudo -u "$SVC_USER"); fi
as_bot() { "${AS_USER[@]}" env HOME="$DIR" \
  ${PW_PATH:+PLAYWRIGHT_BROWSERS_PATH="$PW_PATH"} "$@"; }

usage() {
  cat <<EOF
${BD}${APP}${N} — уведомления Avito и VK в Telegram

  ${APP}                    ${BD}меню${N} — всё в одном месте

${BD}Или сразу командой${N}
  ${APP} ${BD}status${N}            состояние службы и самопроверка
  ${APP} ${BD}logs${N} [-f]         логи (-f — следить вживую)
  ${APP} ${BD}start${N} | ${BD}stop${N} | ${BD}restart${N}
  ${APP} ${BD}selfcheck${N}         проверить токен, доступы, каталоги
  ${APP} ${BD}login${N}             войти в Авито/ВК ${D}(режим browser)${N}
  ${APP} ${BD}config${N}            показать настройки (токен скрыт)
  ${APP} ${BD}config${N} КЛЮЧ ЗНАЧ  изменить и перезапустить
  ${APP} ${BD}reconfigure${N}       спросить всё заново
  ${APP} ${BD}uninstall${N}         удалить, данные оставить
  ${APP} ${BD}uninstall --full${N}  снести подчистую: данные, профиль,
                             браузер, пользователя и swap установщика

${BD}Ключи для config${N}
  token       токен бота от @BotFather
  owner       кто управляет: @username или id
  recipient   кому слать: @username, @канал или id
  mode        light или browser

${BD}Примеры${N}
  ${APP} config recipient @sabzrr
  ${APP} config token 123456:AA...
EOF
}

# правит ключ в .env, создаёт если его там не было
set_env() {
  local k="$1" v="$2"
  if grep -qE "^${k}=" "$DIR/.env" 2>/dev/null; then
    sed -i -E "s#^${k}=.*#${k}=${v}#" "$DIR/.env"
  else
    printf '%s=%s\n' "$k" "$v" >> "$DIR/.env"
  fi
  chown root:"$SVC_USER" "$DIR/.env" 2>/dev/null || true
  chmod 640 "$DIR/.env" 2>/dev/null || true
}

key_of() {
  case "$1" in
    token|TG_TOKEN)             echo TG_TOKEN;;
    owner|TG_OWNER)             echo TG_OWNER;;
    recipient|to|TG_RECIPIENT)  echo TG_RECIPIENT;;
    mode|BOT_MODE)              echo BOT_MODE;;
    *) echo "";;
  esac
}

cmd_config() {
  if [ $# -eq 0 ]; then
    sed -E 's/^(TG_TOKEN=).*/\1<скрыт>/' "$DIR/.env"
    echo
    printf '  %sизменить:%s %s config recipient @name\n' "$D" "$N" "$APP"
    printf '  %sзаново:  %s %s reconfigure\n' "$D" "$N" "$APP"
    return 0
  fi
  need_root config
  [ $# -ge 2 ] || die "нужно: ${APP} config КЛЮЧ ЗНАЧЕНИЕ"
  local k; k="$(key_of "$1")"
  [ -n "$k" ] || die "неизвестный ключ «$1» (token, owner, recipient, mode)"
  local v="$2"
  case "$k" in
    TG_TOKEN)  [[ "$v" == *:* ]] || die "токен не похож на токен";;
    TG_OWNER)  v="${v#@}";;
    TG_RECIPIENT)
      case "$v" in ""|@*) ;; *[!0-9-]*) v="@${v}";; esac;;
    BOT_MODE)
      case "$v" in light|browser) ;; *) die "режим: light или browser";; esac
      if [ "$v" = "browser" ] && [ ! -x "$DIR/venv/bin/python3" ]; then
        die "для browser нужен браузер — переустанови: install.sh --mode browser"
      fi
      set_env BOT_HEADLESS "$([ "$v" = browser ] && echo 1 || echo "")";;
  esac
  set_env "$k" "$v"
  ok "${k} = ${v}"
  systemctl restart "${APP}.service" 2>/dev/null \
    && ok "бот перезапущен" || warn "служба не запущена — стартани: ${APP} start"
}

# ------------------------------------------------------------------- меню ---
menu_header() {
  local act mem line
  act="$(systemctl is-active "${APP}.service" 2>/dev/null || true)"
  mem="$(systemctl show "${APP}.service" -p MemoryCurrent --value 2>/dev/null || echo 0)"
  case "$mem" in ''|*[!0-9]*) mem=0;; esac
  printf '\n  %s%s%s  %s— уведомления Avito и VK в Telegram%s\n' \
    "$BD" "$APP" "$N" "$D" "$N"
  printf '  %s─────────────────────────────────────────────%s\n' "$D" "$N"
  if [ "$act" = "active" ]; then
    line="${G}● работает${N}"
    [ "$mem" -gt 0 ] && line="$line  ${D}$((mem/1048576)) МБ${N}"
  else
    line="${Y}○ остановлен${N}"
  fi
  printf '  %b\n' "$line"
  printf '  %sрежим:%s %-8s %sполучатель:%s %s\n' \
    "$D" "$N" "$(mode)" "$D" "$N" "$(envval TG_RECIPIENT)"
  printf '\n'
}

pause() { printf '\n  %sEnter — назад%s' "$D" "$N"; read -r _ || true; }

menu_settings() {
  local c v
  while true; do
    printf '\n  %sНастройки%s\n\n' "$BD" "$N"
    printf '    1  получатель   %s\n' "$(envval TG_RECIPIENT)"
    printf '    2  владелец     %s\n' "$(envval TG_OWNER)"
    printf '    3  токен        %sскрыт%s\n' "$D" "$N"
    printf '    4  период опроса\n'
    printf '    5  режим        %s\n' "$(mode)"
    printf '    6  показать всё\n'
    printf '    0  назад\n\n'
    printf '  > '; read -r c || return 0
    case "$c" in
      1) printf '  Кому слать (@username или id): '; read -r v || true
         [ -n "${v:-}" ] && cmd_config recipient "$v"; pause;;
      2) printf '  Кто управляет (@username или id): '; read -r v || true
         [ -n "${v:-}" ] && cmd_config owner "$v"; pause;;
      3) printf '  Новый токен: '; read -r v || true
         [ -n "${v:-}" ] && cmd_config token "$v"; pause;;
      4) printf '  Период опроса в секундах: '; read -r v || true
         if [ -n "${v:-}" ]; then set_interval "$v"; fi; pause;;
      5) printf '  Режим (light/browser): '; read -r v || true
         [ -n "${v:-}" ] && cmd_config mode "$v"; pause;;
      6) cmd_config; pause;;
      0|"") return 0;;
      *) warn "не понял";;
    esac
  done
}

set_interval() {
  need_root menu
  "$PY" - "$DIR/data/config.json" "$1" <<'PYEOF'
import json, os, sys
path, val = sys.argv[1], sys.argv[2]
try:
    val = max(10, int(val))
except ValueError:
    print("нужно число"); raise SystemExit(1)
try:
    d = json.load(open(path, encoding="utf-8"))
except Exception:
    d = {}
d["interval"] = val
os.makedirs(os.path.dirname(path), exist_ok=True)
json.dump(d, open(path, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
print("период опроса: %d сек" % val)
PYEOF
  chown "$SVC_USER":"$SVC_USER" "$DIR/data/config.json" 2>/dev/null || true
  systemctl restart "${APP}.service" 2>/dev/null && ok "бот перезапущен" || true
}

menu_delete() {
  local c v
  printf '\n  %sУдаление%s\n\n' "$BD" "$N"
  printf '    1  удалить, данные оставить\n'
  printf '    2  снести подчистую %s(куки, профиль, браузер, swap)%s\n' "$D" "$N"
  printf '    0  назад\n\n'
  printf '  > '; read -r c || return 0
  case "$c" in
    1) cmd_uninstall; exit 0;;
    2) printf '  %sЭто сотрёт все данные без возврата.%s\n' "$Y" "$N"
       printf '  Напиши %sудалить%s для подтверждения: ' "$BD" "$N"
       read -r v || true
       if [ "${v:-}" = "удалить" ]; then cmd_uninstall --full; exit 0
       else warn "отменено"; pause; fi;;
    *) return 0;;
  esac
}

cmd_menu() {
  [ -t 0 ] || { usage; exit 0; }
  while true; do
    menu_header
    printf '    1  статус и самопроверка\n'
    printf '    2  логи вживую\n'
    printf '    3  перезапустить\n'
    printf '    4  настройки\n'
    [ "$(mode)" = "browser" ] && printf '    5  войти в Авито и ВК\n'
    printf '    9  удалить\n'
    printf '    0  выход\n\n'
    printf '  > '
    local c; read -r c || return 0
    case "$c" in
      1) cmd_status; pause;;
      2) printf '  %sCtrl+C — назад%s\n\n' "$D" "$N"
         journalctl -u "${APP}.service" -f -o cat || true;;
      3) need_root restart; systemctl restart "${APP}.service" && ok "перезапущен"; pause;;
      4) menu_settings;;
      5) [ "$(mode)" = "browser" ] && cmd_login || warn "только в режиме browser"; pause;;
      9) menu_delete;;
      0|"") printf '\n'; return 0;;
      *) warn "не понял";;
    esac
  done
}

cmd_uninstall() {
  need_root uninstall
  local FULL=0
  case "${1:-}" in --full|--purge|full) FULL=1;; esac

  if [ "$FULL" != "1" ] && [ "${2:-}" != "-y" ] && [ -t 0 ]; then :; fi

  systemctl disable --now "${APP}.service" 2>/dev/null || true
  rm -f "$UNIT_PATH"
  systemctl daemon-reload 2>/dev/null || true
  ok "служба остановлена и удалена"

  if [ "$FULL" = "1" ]; then
    stray_kill
    rm -rf "$DIR"
    ok "каталог ${DIR} удалён вместе с данными, профилем и браузером"
    userdel -r "$SVC_USER" 2>/dev/null || true
    ok "пользователь ${SVC_USER} удалён"
    if grep -q '^/swapfile' /etc/fstab 2>/dev/null && [ -f /swapfile ]; then
      swapoff /swapfile 2>/dev/null || true
      sed -i '\#^/swapfile#d' /etc/fstab
      rm -f /swapfile
      ok "swapfile, созданный установщиком, убран"
    fi
    rm -f "$CLI_PATH"
    echo
    ok "удалено полностью — следов не осталось"
    warn "системные пакеты (python3, xvfb, novnc…) не трогал:"
    warn "их могли ставить не мы, и на них могут опираться другие сервисы"
  else
    rm -f "$DIR/bot.py" "$DIR/.env"
    rm -rf "$DIR/__pycache__"
    ok "данные сохранены в ${DIR}/data"
    rm -f "$CLI_PATH"
    echo
    ok "удалено, данные на месте"
    printf '  %sснести подчистую:%s sudo %s uninstall --full\n' "$D" "$N" "$APP"
  fi
}

cmd_reconfigure() {
  need_root reconfigure
  local cur_owner cur_rcp cur_mode a
  cur_owner="$(envval TG_OWNER)"; cur_rcp="$(envval TG_RECIPIENT)"
  cur_mode="$(mode)"
  echo "  Enter — оставить как есть."
  echo
  read -r -p "  Токен бота [${D}скрыт${N}]: " a || true
  [ -n "$a" ] && { [[ "$a" == *:* ]] || die "токен не похож на токен"; set_env TG_TOKEN "$a"; }
  read -r -p "  Кто управляет ботом [${cur_owner}]: " a || true
  [ -n "$a" ] && set_env TG_OWNER "${a#@}"
  read -r -p "  Кому слать уведомления [${cur_rcp}]: " a || true
  if [ -n "$a" ]; then
    case "$a" in ""|@*) ;; *[!0-9-]*) a="@${a}";; esac
    set_env TG_RECIPIENT "$a"
  fi
  echo
  ok "настройки записаны"
  systemctl restart "${APP}.service" 2>/dev/null \
    && ok "бот перезапущен" || warn "служба не запущена — стартани: ${APP} start"
  echo
  as_bot "$PY" "$DIR/bot.py" --selfcheck 2>&1 | sed 's/^/  /' || true
}

cmd_status() {
  local act; act="$(systemctl is-active "${APP}.service" 2>/dev/null || true)"
  if [ "$act" = "active" ]; then ok "служба работает"; else warn "служба: ${act:-нет}"; fi
  local mem; mem="$(systemctl show "${APP}.service" -p MemoryCurrent --value 2>/dev/null || echo 0)"
  case "$mem" in ''|*[!0-9]*) mem=0;; esac
  [ "$mem" -gt 0 ] && printf '  %sпамять:%s %s МБ\n' "$D" "$N" "$((mem/1048576))"
  printf '  %sрежим:%s %s\n' "$D" "$N" "$(mode)"
  echo
  as_bot "$PY" "$DIR/bot.py" --selfcheck 2>&1 | sed 's/^/  /' || true
  echo
  printf '  %sпоследние строки лога:%s\n' "$D" "$N"
  journalctl -u "${APP}.service" -n 8 --no-pager -o cat 2>/dev/null | sed 's/^/    /' || true
}

cmd_login() {
  need_root login
  [ "$(mode)" = "browser" ] || die "вход нужен только в режиме browser (сейчас: $(mode))"
  command -v Xvfb >/dev/null || die "нет Xvfb — переустанови с --mode browser"
  command -v websockify >/dev/null || die "нет websockify/novnc — переустанови с --mode browser"

  local NOVNC=/usr/share/novnc
  [ -d "$NOVNC" ] || NOVNC=/usr/share/webapps/novnc
  [ -d "$NOVNC" ] || die "не нашёл novnc"

  WAS_ACTIVE=0
  systemctl is-active --quiet "${APP}.service" && WAS_ACTIVE=1
  if [ "$WAS_ACTIVE" = "1" ]; then
    echo "  Останавливаю бота, чтобы освободить профиль браузера..."
    systemctl stop "${APP}.service" 2>/dev/null || true
  fi

  # подчистим хвосты прошлого входа, иначе :99 будет занят
  stray_kill

  tmp="$(mktemp -d)"           # намеренно глобальная: нужна в trap
  CLEANED=0
  cleanup() {
    [ "${CLEANED:-0}" = "1" ] && return 0
    CLEANED=1
    for p in "${PY_PID:-}" "${WS_PID:-}" "${VNC_PID:-}" "${X_PID:-}"; do
      [ -n "$p" ] && kill "$p" 2>/dev/null
    done
    sleep 1
    stray_kill
    [ -n "${tmp:-}" ] && rm -rf "$tmp"
    if [ "$WAS_ACTIVE" = "1" ]; then
      systemctl start "${APP}.service" 2>/dev/null || true
      echo; ok "бот снова запущен"
    else
      echo; ok "готово (служба была остановлена — не трогаю)"
    fi
    return 0
  }
  trap cleanup EXIT INT TERM

  Xvfb :99 -screen 0 1280x900x24 >/dev/null 2>&1 & X_PID=$!
  sleep 1
  x11vnc -display :99 -localhost -nopw -forever -shared -quiet >/dev/null 2>&1 & VNC_PID=$!
  sleep 1
  websockify --web="$NOVNC" 127.0.0.1:6080 127.0.0.1:5900 >/dev/null 2>&1 & WS_PID=$!
  sleep 1

  cat > "$tmp/login.py" <<'PYEOF'
import os
from playwright.sync_api import sync_playwright
BROWSER_DIR = os.path.join(os.environ["BOT_DIR"], "data", "browser")
os.makedirs(BROWSER_DIR, exist_ok=True)
UA = ("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
      "(KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36")
with sync_playwright() as pw:
    ctx = pw.chromium.launch_persistent_context(
        BROWSER_DIR, headless=False,
        viewport={"width": 1280, "height": 860},
        locale="ru-RU", timezone_id="Europe/Moscow", user_agent=UA,
        args=["--no-sandbox", "--disable-dev-shm-usage",
              "--disable-blink-features=AutomationControlled"])
    p = ctx.pages[0] if ctx.pages else ctx.new_page()
    try: p.goto("https://www.avito.ru/profile/messenger", timeout=60000)
    except Exception: pass
    v = ctx.new_page()
    try: v.goto("https://vk.ru/im", timeout=60000)
    except Exception: pass
    print("BROWSER_READY", flush=True)
    while True:
        p.wait_for_timeout(5000)
PYEOF
  chmod 755 "$tmp"; chown -R "$SVC_USER":"$SVC_USER" "$tmp"
  "${AS_USER[@]}" env DISPLAY=:99 HOME="$DIR" BOT_DIR="$DIR" \
      ${PW_PATH:+PLAYWRIGHT_BROWSERS_PATH="$PW_PATH"} \
      "$PY" "$tmp/login.py" >"$tmp/out" 2>&1 & PY_PID=$!
  for _ in $(seq 1 30); do grep -q BROWSER_READY "$tmp/out" 2>/dev/null && break; sleep 1; done

  echo
  echo "  ${BD}Браузер запущен.${N} Открой его у себя так:"
  echo
  echo "    1) на своём компьютере выполни:"
  echo "       ${BD}ssh -N -L 6080:127.0.0.1:6080 $(whoami)@$(hostname -I 2>/dev/null | awk '{print $1}')${N}"
  echo "    2) открой в браузере:  ${BD}http://localhost:6080/vnc.html${N}"
  echo "    3) залогинься во вкладках Авито и ВК"
  echo
  echo "  ${D}Порт наружу не торчит — только через твой SSH-туннель.${N}"
  echo "  Когда закончишь — нажми ${BD}Ctrl+C${N} здесь."
  echo
  while kill -0 "$PY_PID" 2>/dev/null; do sleep 2; done
}

case "${1:-menu}" in
  menu|"")   cmd_menu;;
  status)    cmd_status;;
  logs)      shift; if [ "${1:-}" = "-f" ]; then journalctl -u "${APP}.service" -f -o cat
             else journalctl -u "${APP}.service" -n "${1:-50}" --no-pager -o cat; fi;;
  start)     need_root start; systemctl start "${APP}.service"; ok "запущен";;
  stop)      need_root stop; systemctl stop "${APP}.service"; ok "остановлен";;
  restart)   need_root restart; systemctl restart "${APP}.service"; ok "перезапущен";;
  selfcheck) as_bot "$PY" "$DIR/bot.py" --selfcheck;;
  login)     cmd_login;;
  config)    shift; cmd_config "$@";;
  reconfigure|reconf) cmd_reconfigure;;
  uninstall|purge) shift; cmd_uninstall "$@";;
  help|-h|--help) usage;;
  *)         usage; exit 1;;
esac
