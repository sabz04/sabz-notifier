# Токен бота из @BotFather
TG_TOKEN=123456789:AA...

# Кто управляет ботом: @username или числовой id. Остальных бот игнорирует.
# Это ТВОЙ аккаунт в Telegram, а не имя бота.
TG_OWNER=yourname

# Кому слать уведомления: @username, @канал или числовой id.
# Пусто — туда, откуда владелец написал /start.
TG_RECIPIENT=

# 1 — окно не показывать (так работает на сервере).
# Браузер при этом обычный, просто живёт на виртуальном экране Xvfb:
# настоящий headless слишком легко отличить, и сайты его режут.
# На десктопе оставь пустым, чтобы видеть окно.
BOT_HEADLESS=1

PYTHONIOENCODING=utf-8
