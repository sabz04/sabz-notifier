# Токен бота из @BotFather
TG_TOKEN=123456789:AA...

# Кто управляет ботом: @username или числовой id. Остальных бот игнорирует.
TG_OWNER=yourname

# Кому слать уведомления: @username, @канал или числовой id.
# Пусто — туда, откуда владелец написал /start.
TG_RECIPIENT=

# light  — без браузера, куки/токен присылаются боту в Telegram (~25 МБ RAM)
# browser — свой профиль браузера, вход один раз (нужно >=2 ГБ RAM)
BOT_MODE=light

# 1 — браузер без окна (для сервера). На десктопе оставь пустым.
BOT_HEADLESS=

PYTHONIOENCODING=utf-8
